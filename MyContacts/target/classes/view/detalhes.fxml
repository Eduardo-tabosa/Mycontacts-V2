<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.DetalhesController"
      styleClass="formulario" spacing="18" prefWidth="400">

    <HBox spacing="14" alignment="CENTER_LEFT">
        <Label fx:id="lblIniciais" styleClass="avatar" text="MS"/>
        <VBox spacing="4">
            <Label fx:id="lblNome" styleClass="titulo-form" text="Nome"/>
            <Label fx:id="lblTipo" styleClass="etiqueta-tipo" text="Pessoal"/>
        </VBox>
    </HBox>

    <GridPane hgap="14" vgap="10" styleClass="detalhes-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="80"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Telefone" styleClass="rotulo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="lblTelefone" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="E-mail" styleClass="rotulo" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="lblEmail" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Empresa" styleClass="rotulo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lblEmpresa" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Fechar" onAction="#onFechar" styleClass="botao-primario" defaultButton="true" cancelButton="true"/>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.PrincipalController"
            styleClass="raiz">

    <top>
        <VBox styleClass="cabecalho" spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="2">
                    <Label text="MyContacts" styleClass="titulo"/>
                    <Label text="Sua agenda de contatos" styleClass="subtitulo"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal" styleClass="contador" text="0 contatos"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBusca" promptText="Buscar por nome..."
                           HBox.hgrow="ALWAYS" styleClass="busca"/>
                <ComboBox fx:id="cbFiltro" prefWidth="150"/>
                <Button text="Limpar" onAction="#onLimparBusca" styleClass="botao-secundario"/>
            </HBox>
        </VBox>
    </top>

    <!-- Lista de contatos -->
    <center>
        <TableView fx:id="tabela" styleClass="tabela">
            <BorderPane.margin>
                <Insets left="24" right="24"/>
            </BorderPane.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Nenhum contato por aqui. Clique em &quot;Novo contato&quot; para começar."
                       styleClass="vazio"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colNome" text="Nome" prefWidth="200"/>
                <TableColumn fx:id="colTelefone" text="Telefone" prefWidth="140"/>
                <TableColumn fx:id="colEmail" text="E-mail" prefWidth="220"/>
                <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="150"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <!-- Açoes -->
    <bottom>
        <HBox styleClass="rodape" spacing="10" alignment="CENTER_LEFT">
            <Button text="+ Novo contato" onAction="#onNovo" styleClass="botao-primario" defaultButton="false"/>
            <Button fx:id="btnEditar" text="Editar" onAction="#onEditar" styleClass="botao-secundario"/>
            <Button fx:id="btnDetalhes" text="Detalhes" onAction="#onDetalhes" styleClass="botao-secundario"/>
            <Button fx:id="btnRemover" text="Remover" onAction="#onRemover" styleClass="botao-perigo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblStatus" styleClass="status"/>
        </HBox>
    </bottom>
</BorderPane>
